# TinaCloud credentials for editing the LIVE site (Option B).
# Copy this file to `.env` and fill in the values from https://app.tina.io
# `.env` is git-ignored — never commit real tokens.

# From your TinaCloud project's "Overview" tab:
TINA_CLIENT_ID=
# From TinaCloud > project > "Tokens" (the read-only content token):
TINA_TOKEN=
# The git branch TinaCloud reads/writes:
TINA_BRANCH=main
